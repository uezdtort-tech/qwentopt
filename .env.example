# Conditera Next - Environment Variables
# Скопируйте этот файл в .env и заполните необходимые значения
# НЕ коммитьте файл .env с реальными значениями в Git!

# ============================================================================
# Режим работы приложения
# ============================================================================
# local - локальная разработка с тестовыми данными
# sandbox - тестовая среда с реальными API (тестовые ключи)
# production - боевая среда
APP_MODE=local

# ============================================================================
# YooKassa (Платежная система)
# ============================================================================
# Получите credentials в личном кабинете YooKassa
# Документация: https://yookassa.ru/developers/
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_MODE=local

# ============================================================================
# Яндекс ID (OAuth)
# ============================================================================
# Зарегистрируйте приложение: https://oauth.yandex.com/client/new
# Redirect URI: https://yourdomain.com/auth/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3000/auth/callback

# ============================================================================
# VK ID (OAuth)
# ============================================================================
# Зарегистрируйте приложение: https://dev.vk.com/
# Redirect URI: https://yourdomain.com/auth/callback
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://localhost:3000/auth/callback

# ============================================================================
# SMTP (Email)
# ============================================================================
# Настройки SMTP сервера для отправки email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
SMTP_SECURE=false

# ============================================================================
# Telegram (Уведомления)
# ============================================================================
# Создайте бота через @BotFather в Telegram
# Получите chat_id через @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================================
# Supabase (База данных)
# ============================================================================
# Получите в Settings -> API вашего проекта Supabase
# Документация: https://supabase.com/docs
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# Ollama (AI)
# ============================================================================
# Установите Ollama: https://ollama.ai/
# Запустите: ollama pull llama3
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ============================================================================
# n8n (Автоматизация)
# ============================================================================
# Установите n8n: https://docs.n8n.io/getting-started/installation/
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ============================================================================
# Домен и HTTPS
# ============================================================================
APP_URL=http://localhost:3000
APP_DOMAIN=localhost

# ============================================================================
# Безопасность
# ============================================================================
# Секретный ключ для подписи JWT токенов
# Сгенерируйте: openssl rand -base64 32
JWT_SECRET=

# Ключ для шифрования чувствительных данных
ENCRYPTION_KEY=

# ============================================================================
# Логирование
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================================================
# Кэширование
# ============================================================================
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_OAUTH=true
ENABLE_PAYMENTS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_TELEGRAM_NOTIFICATIONS=true
ENABLE_AI_ASSISTANT=true
ENABLE_AUTOMATION=true

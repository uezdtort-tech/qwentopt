# ============================================
# Conditera Next — Переменные окружения
# ============================================
# Скопируйте этот файл в .env и заполните значения
# НЕ КОММИТЬТЕ .env В РЕПОЗИТОРИЙ!

# ============================================
# Supabase (self-hosted)
# ============================================
VITE_SUPABASE_URL=https://your-supabase-instance.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key — ТОЛЬКО НА СЕРВЕРЕ, никогда в браузере!
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# OAuth — Яндекс ID
# ============================================
# Получите в https://oauth.yandex.ru/client/new
VITE_YANDEX_CLIENT_ID=your-yandex-client-id
# Client secret хранится ТОЛЬКО на сервере
# YANDEX_CLIENT_SECRET=your-yandex-client-secret

# ============================================
# OAuth — VK ID
# ============================================
# Получите в https://dev.vk.com/
VITE_VK_ID_CLIENT_ID=your-vk-client-id
# Client secret хранится ТОЛЬКО на сервере
# VK_ID_CLIENT_SECRET=your-vk-client-secret

# ============================================
# OAuth — Общие настройки
# ============================================
# Redirect URI для OAuth callback
# Локальная разработка:
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
# Production:
# VITE_OAUTH_REDIRECT_URI=https://conditera.ru/auth/callback

# ============================================
# Ollama (локальный AI)
# ============================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ============================================
# n8n (автоматизация)
# ============================================
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret

# ============================================
# Приложение
# ============================================
VITE_APP_URL=https://conditera.ru
NODE_ENV=development
